# Environment Configuration for AI Personal Finance Copilot MVP

# Database
DATABASE_URL="file:./prisma/dev.db"

# AI & LLM Integration
LLM_API_KEY="your-api-key-here"
LLM_MODEL="gpt-4o-mini"  # or your preferred company-permitted model
LLM_BASE_URL="https://api.openai.com/v1"  # Update if using different LLM provider

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="FinCopilot"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# Optional: Logging and Observability
LOG_LEVEL="info"  # debug, info, warn, error
